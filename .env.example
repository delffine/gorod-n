# Ключи API проекта «Город Н». Этот файл НЕ публиковать и НЕ коммитить.

# --- Cloudflare Workers AI (генерация картинок, FLUX.1 schnell) ---
# Account ID: dash.cloudflare.com → AI → Workers AI → Use REST API
CLOUDFLARE_ACCOUNT_ID=
# API-токен с правами Workers AI (там же, кнопка Create a Workers AI API Token)
CLOUDFLARE_API_TOKEN=

# --- ВКонтакте (публикация постов в группу) ---
# ID группы — число, без минуса (Управление → Основная информация → адрес вида club123456)
VK_GROUP_ID=
# Ключ доступа: Управление сообществом → Дополнительно → Работа с API → Создать ключ
# Права: «Управление сообществом», «Фотографии», «Стена»
VK_TOKEN=
# --- ВКонтакте: ключ пользователя-администратора (VK ID) ---
# ID приложения из кабинета VK ID и доверенный redirect URL (тот же, что в кабинете)
VK_CLIENT_ID=
VK_REDIRECT_URI=
# Заполняются автоматически скриптом scripts/vk_auth.py
VK_USER_TOKEN=
VK_REFRESH_TOKEN=
VK_DEVICE_ID=
VK_TOKEN_EXPIRES=

# --- ВКонтакте: ключ администратора группы (oauth.vk.com, права wall,photos,groups,offline) ---
VK_ADMIN_TOKEN=
