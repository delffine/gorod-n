# Ключи API проекта «Город Н». Сами ключи сюда НЕ записывать — это шаблон в репозитории.
# Ключи живут в переменных окружения, по одному месту на компьютер:
#   Windows — переменные пользователя: setx ИМЯ "значение", потом перезапустить терминал;
#   VPS     — ~/.config/gorodn.env (его подгружают auto/run.sh, auto/inbox.sh, auto/inbox_bot.sh).
# Скрипты как запасной вариант читают .env в корне проекта, но MCP Postmypost его не видит.

# --- Cloudflare Workers AI (картинки: gen_image.py, gen_cover.py, photo_sketch.py) ---
# Account ID: dash.cloudflare.com → AI → Workers AI → Use REST API
CLOUDFLARE_ACCOUNT_ID=
# API-токен с правами Workers AI (там же, кнопка Create a Workers AI API Token)
CLOUDFLARE_API_TOKEN=

# --- Postmypost (публикация во все сети: .mcp.json подставляет ${PMP_TOKEN}, читает scripts/pmp_api.py) ---
PMP_TOKEN=

# --- только VPS: Claude Code и боты-приёмники (scripts/inbox_bot.py) ---
# CLAUDE_CODE_OAUTH_TOKEN=
# TG_BOT_TOKEN=
# TG_BOT_ALLOWED=
# MAX_BOT_TOKEN=
# MAX_BOT_ALLOWED=
